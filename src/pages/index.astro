---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Marquee from '../components/Marquee.astro';
import { currently, site, skills, whispers } from '../data/site';
import { photos } from '../lib/photos';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order).slice(0, 5);

const trail = await Promise.all(photos.slice(0, 10).map((p) => getImage({ src: p.src, width: 360, format: 'webp' })));
const trailSrcs = JSON.stringify(trail.map((t) => t.src));

const nameChars = (s: string) => [...s].map((c) => (c === ' ' ? ' ' : c));
const beyond = [
  { title: 'Music', href: '/music', blurb: 'Sketches, loops, half-finished songs', photo: photos[2] },
  { title: 'Poetry', href: '/poetry', blurb: 'Short poems from long shifts', photo: photos[5] },
  { title: 'Gallery', href: '/gallery', blurb: 'Light hitting things', photo: photos[8] },
  { title: 'Lab', href: '/lab', blurb: 'Experiments & everything else', photo: photos[11] },
];
---

<Base>
  <!-- Hero -->
  <section class="hero" data-trail={trailSrcs}>
    <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
      <p class="eyebrow hero-eyebrow" data-reveal>Engineer · Researcher · Writer, based in St. Louis</p>
      <h1 class="hero-name display" data-explode data-cursor="hold" aria-label={site.name}>
        <span class="row" aria-hidden="true">{nameChars(site.first).map((c, i) => <span class="char" style={`--i:${i}`}>{c}</span>)}</span>
        <span class="row italic" aria-hidden="true">{nameChars(site.last).map((c, i) => <span class="char" style={`--i:${i + 6}`}>{c}</span>)}<span class="char dot">.</span></span>
      </h1>
      <div class="hero-bottom">
        <p class="hero-role" data-reveal style="--d:.6s">
          Currently a <span class="role accent mono" data-rotate-words={JSON.stringify(site.roles)}>{site.roles[0]}</span>
        </p>
        <div class="hero-clock mono" data-reveal style="--d:.75s">
          <span class="pulse" aria-hidden="true"></span>
          <span>STL <span data-clock>--:--</span></span>
          <span class="muted" data-status></span>
        </div>
      </div>
    </div>
    <a href="#intro" class="scroll-hint mono" data-magnetic data-cursor="scroll">
      <span>scroll</span><span class="line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- Intro -->
  <section id="intro" class="wrap intro">
    <p class="eyebrow" data-reveal>Hello</p>
    <p class="intro-text display" data-split>
      I build AI and software that holds up in the real world, from research on{' '}
      <span class="whisper" data-line={whispers[4]}>when models should abstain</span>{' '}
      to the touchscreen system behind a busy{' '}
      <span class="whisper" data-line={whispers[0]}>restaurant</span>.{' '}
      Off the clock I write <span class="whisper" data-line={whispers[2]}>poems</span> and make music.
    </p>
    <div class="currently">
      {currently.map((c, i) => (
        <div class="cur" data-reveal style={`--d:${i * 0.08}s`}>
          <span class="mono muted">{c.label}</span>
          <span>{c.value}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Numbers -->
  <section class="wrap stats">
    {[
      { n: 5000, s: '+', l: 'students on a platform I helped build' },
      { n: 95, s: '%', l: 'detection accuracy on a vision pipeline' },
      { n: 50, s: '+', l: 'security risk assessments run' },
      { n: 250, s: '+', l: 'careers mapped with AI matching' },
    ].map((x, i) => (
      <div class="stat" data-reveal style={`--d:${i * 0.1}s`}>
        <span class="stat-n display" data-count={x.n} data-suffix={x.s}>0</span>
        <span class="muted">{x.l}</span>
      </div>
    ))}
  </section>

  <Marquee items={[...skills.languages, ...skills.tools]} speed={45} />

  <!-- Featured projects: horizontal scroll -->
  <section class="featured" data-hscroll>
    <div class="featured-head wrap">
      <p class="eyebrow">Selected work</p>
      <h2 class="display section-title" data-split>Things I've <em>built</em></h2>
    </div>
    <div class="featured-track" data-hscroll-track>
      {featured.map((p, i) => (
        <div class="featured-item"><ProjectCard project={p} index={i} /></div>
      ))}
      <a href="/projects" class="featured-more display" data-cursor="all">
        <span>All projects</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Experience teaser -->
  <section class="wrap exp">
    <div class="exp-head">
      <p class="eyebrow">Experience</p>
      <h2 class="display section-title" data-split>Where I've <em>worked</em></h2>
    </div>
    <ul class="exp-list">
      {jobs.map((j, i) => (
        <li data-reveal style={`--d:${i * 0.06}s`}>
          <a href="/experience" class="exp-row" data-cursor="more">
            <span class="mono muted">{String(i + 1).padStart(2, '0')}</span>
            <span class="exp-role display">{j.data.role}</span>
            <span class="exp-org">{j.data.org}</span>
            <span class="mono muted exp-date">{j.data.current ? 'Now' : j.data.end}</span>
          </a>
        </li>
      ))}
    </ul>
    <a href="/experience" class="btn" data-magnetic>Full timeline →</a>
  </section>

  <!-- Beyond the code -->
  <section class="wrap beyond">
    <p class="eyebrow" data-reveal>Beyond the code</p>
    <h2 class="display section-title" data-split>The <em>other</em> half</h2>
    <div class="beyond-grid">
      {beyond.map((b, i) => (
        <a href={b.href} class="beyond-card" data-cursor="open" data-reveal style={`--d:${i * 0.08}s`}>
          <div class="beyond-media" data-unmask>
            {b.photo && <Image src={b.photo.src} alt="" widths={[400, 700]} sizes="(max-width: 700px) 90vw, 25vw" data-zoom />}
          </div>
          <div class="beyond-text">
            <h3 class="display">{b.title}</h3>
            <p class="muted">{b.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 2s; }
  .hero-canvas:global(.ready) { opacity: 1; }
  .hero-inner { position: relative; z-index: 2; padding-bottom: clamp(5rem, 12vh, 8rem); pointer-events: none; }
  .hero-inner > * { pointer-events: auto; }
  .hero-name {
    font-size: clamp(4.5rem, 19vw, 19rem);
    line-height: 0.82;
    margin: 1.2rem 0 2rem;
    user-select: none; touch-action: none;
    width: fit-content;
  }
  .hero-name .row { display: block; white-space: nowrap; }
  .hero-name .row.italic { padding-left: 0.6em; }
  .char {
    display: inline-block;
    transition: font-variation-settings 0.6s var(--ease), transform 0.6s var(--ease), color 0.4s;
    animation: char-in 1.4s var(--ease) backwards;
    animation-delay: calc(var(--i) * 0.05s + 0.1s);
  }
  .char:hover { font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144, 'wght' 800; transform: translateY(-0.06em) rotate(-4deg); color: var(--accent); }
  .char.dot { color: var(--accent); }
  @keyframes char-in { from { transform: translateY(110%) rotate(8deg); opacity: 0; } }
  .hero-name:global(.charging) { animation: shake 0.12s linear infinite; }
  .hero-name:global(.charging) .char { color: var(--accent); }
  @keyframes shake { 0% { transform: translate(1px, 0); } 50% { transform: translate(-1px, 1px); } 100% { transform: translate(0, -1px); } }

  .hero-bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
  .hero-role { font-size: clamp(1.1rem, 1.8vw, 1.5rem); }
  .role { display: inline-block; min-width: 18ch; }
  .hero-clock { display: flex; align-items: center; gap: 0.8rem; font-size: 0.8rem; flex-wrap: wrap; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #3ddc84; box-shadow: 0 0 0 0 #3ddc84; animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px transparent; } }
  .scroll-hint { position: absolute; right: var(--pad); bottom: 2rem; z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; writing-mode: vertical-rl; }
  .scroll-hint .line { width: 1px; height: 60px; background: var(--fg); transform-origin: top; animation: scrollline 2.2s var(--ease) infinite; }
  @keyframes scrollline { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; } 51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }

  .intro { padding-block: clamp(6rem, 14vw, 12rem) 4rem; }
  .intro-text { font-size: clamp(2rem, 4.6vw, 4.4rem); line-height: 1.08; margin-top: 1.5rem; max-width: 22ch; letter-spacing: -0.03em; }
  .currently { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1px; margin-top: 4rem; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .cur { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.4rem; background: var(--bg); }
  .cur .mono { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; padding-block: 4rem 6rem; }
  .stat { display: flex; flex-direction: column; gap: 0.5rem; border-top: 1px solid var(--fg); padding-top: 1rem; }
  .stat-n { font-size: clamp(3.5rem, 7vw, 6rem); }
  .stat .muted { font-size: 0.9rem; max-width: 24ch; }

  .section-title { font-size: clamp(3rem, 8vw, 7.5rem); margin-top: 0.8rem; }
  .featured { padding-block: clamp(5rem, 10vw, 8rem); overflow: hidden; }
  .featured-head { margin-bottom: 3rem; }
  .featured-track { display: flex; gap: clamp(1.5rem, 3vw, 3rem); padding-inline: var(--pad); width: max-content; align-items: stretch; }
  .featured-item { width: clamp(320px, 38vw, 560px); }
  .featured-more { width: clamp(240px, 24vw, 360px); display: flex; flex-direction: column; justify-content: center; gap: 1rem; font-size: clamp(2.2rem, 3.6vw, 3.4rem); border: 1px solid var(--line); border-radius: var(--radius); padding: 2rem; transition: background 0.5s var(--ease), color 0.5s; }
  .featured-more:hover { background: var(--accent); color: var(--accent-ink); }
  .featured-more .arrow { transition: transform 0.6s var(--ease); display: inline-block; }
  .featured-more:hover .arrow { transform: translateX(20px) rotate(-45deg); }
  @media (max-width: 899px) {
    .featured-track { width: auto; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 1rem; }
    .featured-item, .featured-more { flex: 0 0 82vw; scroll-snap-align: center; }
  }

  .exp { padding-block: 4rem; }
  .exp-list { list-style: none; padding: 0; margin: 3rem 0; border-top: 1px solid var(--line); }
  .exp-row { display: grid; grid-template-columns: 3rem 1.3fr 1fr auto; gap: 1rem; align-items: baseline; padding: 1.6rem 0; border-bottom: 1px solid var(--line); position: relative; transition: padding 0.5s var(--ease), color 0.4s; }
  .exp-row::before { content: ''; position: absolute; inset: 0; background: var(--fg); transform: scaleY(0); transform-origin: bottom; transition: transform 0.5s var(--ease); z-index: -1; }
  .exp-row:hover { padding-inline: 1.2rem; color: var(--bg); }
  .exp-row:hover::before { transform: scaleY(1); }
  .exp-row:hover .muted { color: var(--bg); opacity: 0.6; }
  .exp-role { font-size: clamp(1.4rem, 2.6vw, 2.2rem); }
  .exp-row { isolation: isolate; }
  @media (max-width: 700px) {
    .exp-row { grid-template-columns: 2rem 1fr; }
    .exp-org, .exp-date { grid-column: 2; }
  }

  .beyond { padding-block: 6rem 2rem; }
  .beyond-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-top: 3rem; }
  .beyond-card { display: flex; flex-direction: column; gap: 1rem; }
  .beyond-card:nth-child(even) { margin-top: 4rem; }
  .beyond-media { aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--radius); background: var(--bg-2); }
  .beyond-media img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.6); transition: filter 0.8s; }
  .beyond-card:hover .beyond-media img { filter: none; }
  .beyond-text h3 { font-size: 2rem; transition: transform 0.5s var(--ease); }
  .beyond-card:hover h3 { transform: translateX(0.5rem); font-style: italic; }
  @media (max-width: 900px) { .beyond-grid { grid-template-columns: 1fr 1fr; } }
</style>
