---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Monogram from '../components/Monogram.astro';
import { currently, site, skills, whispers } from '../data/site';
import { photos } from '../lib/photos';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order).slice(0, 5);


// Pins on the CSS globe in the drive teaser: [longitude, latitude].
const pins = [[-90, 38], [-74, 40], [-122, 37], [-103, 44], [-122, 47], [31, 30], [0, 51], [2, 48], [12, 42], [78, 27], [151, -34], [10, 43], [139, 35]];

const nameChars = (s: string) => [...s].map((c) => (c === ' ' ? ' ' : c));
const beyond = [
  { title: 'Music', href: '/music', blurb: 'Music I\'ve made and songs I love', photo: photos[2] },
  { title: 'Poetry', href: '/poetry', blurb: 'Poems from my Fall 2025 portfolio', photo: photos[5] },
  { title: 'Gallery', href: '/gallery', blurb: 'Light hitting things', photo: photos[8] },
  { title: 'Lab', href: '/lab', blurb: 'Experiments & everything else', photo: photos[11] },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <figure class="hero-card" aria-hidden="true" data-reveal style="--d:.3s">
      <div class="hc-bar">
        <span class="hc-dots"><i></i><i></i><i></i></span>
        <span class="mono hc-file">about-me.ts</span>
        <Monogram size={22} />
      </div>
      <pre class="mono hc-code"><code><span class="k">const</span> <span class="v">thien</span> = {'{'}
  role: <span class="s">'Software Engineer'</span>,
  school: <span class="s">'WashU, M.S. CS'</span>,
  builds: [
    <span class="s">'apps'</span>,
    <span class="s">'games'</span>,
    <span class="s">'computer vision'</span>,
  ],
  openTo: <span class="s">'SWE roles, 2027'</span>,
{'}'};<span class="hc-caret"></span></code></pre>
      <figcaption class="hc-foot">
        <span class="hc-status"><span class="pulse"></span>Open to work</span>
        <span class="hand hc-sign">~ Thien</span>
      </figcaption>
    </figure>
    <div class="wrap hero-inner">
      <p class="eyebrow hero-eyebrow" data-reveal>Based in St. Louis</p>
      <h1 class="hero-name display" data-explode data-cursor="hold" aria-label={site.name}>
        <span class="row" aria-hidden="true">{nameChars(site.first).map((c, i) => <span class="char" style={`--i:${i}`}>{c}</span>)}<span class="char space"> </span><span class="italic">{nameChars(site.last).map((c, i) => <span class="char" style={`--i:${i + 6}`}>{c}</span>)}</span><span class="char dot">.</span></span>
      </h1>
      <p class="hero-headline" data-reveal style="--d:.4s">{site.headline}</p>
      <div class="hero-actions" data-reveal style="--d:.55s">
        <span class="start-here hand" aria-hidden="true">
          start here!
          <svg viewBox="0 0 60 50" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M50 4 C 30 6, 14 18, 10 42 M2 32 L10 44 L20 34"/></svg>
        </span>
        <a href="/resume" class="btn solid" data-magnetic>Resume</a>
        <a href="#work" class="btn" data-magnetic>Projects ↓</a>
        <a href={`mailto:${site.email}`} class="btn" data-magnetic>Email me</a>
        <span class="hero-socials mono">
          <a href={site.linkedin} target="_blank" rel="noopener" class="link-line">LinkedIn ↗</a>
          <a href={site.github} target="_blank" rel="noopener" class="link-line">GitHub ↗</a>
        </span>
      </div>
      <div class="hero-clock mono" data-reveal style="--d:.7s">
        <span class="pulse" aria-hidden="true"></span>
        <span>STL <span data-clock>--:--</span></span>
        <span class="muted" data-status></span>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section id="intro" class="wrap intro">
    <p class="intro-text display" data-reveal>
      I build software people <em>actually use</em>: an AI career platform for 5,000+ students, an iOS triage app, and computer vision that turns hours of inventory counting into minutes.
    </p>
    <div class="currently">
      {currently.map((c, i) => (
        <div class="cur" data-reveal style={`--d:${i * 0.08}s`}>
          <span class="mono muted">{c.label}</span>
          <span>{c.value}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Numbers -->
  <section class="wrap stats">
    {[
      { n: 5000, s: '+', l: 'students on a platform I helped build' },
      { n: 95, s: '%', l: 'detection accuracy on a vision pipeline' },
      { n: 50, s: '+', l: 'security risk assessments run' },
      { n: 250, s: '+', l: 'careers mapped with AI matching' },
    ].map((x, i) => (
      <div class="stat" data-reveal style={`--d:${i * 0.1}s`}>
        <span class="stat-n display" data-count={x.n} data-suffix={x.s}>0</span>
        <span class="muted">{x.l}</span>
      </div>
    ))}
  </section>

  <section class="wrap toolbox" data-reveal>
    <div><span class="mono muted">Languages</span><p>{skills.languages.join(' · ')}</p></div>
    <div><span class="mono muted">Tools</span><p>{skills.tools.join(' · ')}</p></div>
  </section>

  <!-- Featured projects -->
  <section id="work" class="wrap featured">
    <div class="featured-head">
      <p class="eyebrow">Selected work</p>
      <h2 class="display section-title" data-flip3d>Things I've <em>built</em></h2>
    </div>
    <div class="featured-grid">
      {featured.map((p, i) => (
        <div class="featured-item" data-reveal style={`--d:${(i % 3) * 0.08}s`}><ProjectCard project={p} index={i} /></div>
      ))}
      <a href="/projects" class="featured-more display" data-cursor="all">
        <span>All {projects.length} projects</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Experience teaser -->
  <section class="wrap exp">
    <div class="exp-head">
      <p class="eyebrow">Experience</p>
      <h2 class="display section-title" data-flip3d>Where I've <em>worked</em></h2>
    </div>
    <ul class="exp-list">
      {jobs.map((j, i) => (
        <li data-reveal style={`--d:${i * 0.06}s`}>
          <a href="/experience" class="exp-row" data-cursor="more">
            <span class="mono muted">{String(i + 1).padStart(2, '0')}</span>
            <span class="exp-role display">{j.data.role}</span>
            <span class="exp-org">{j.data.org}</span>
            <span class="mono muted exp-date">{j.data.current ? 'Now' : j.data.end}</span>
          </a>
        </li>
      ))}
    </ul>
    <a href="/experience" class="btn" data-magnetic>Full timeline →</a>
  </section>

  <!-- Everything below is the fun stuff: drive mode, the order menu, hobbies -->
  <!-- Drive mode teaser -->
  <section class="wrap drive-cta">
    <div class="drive-cta-text">
      <p class="eyebrow" data-reveal>Or take the scenic route</p>
      <h2 class="display section-title" data-flip3d>Drive through my <em>work</em></h2>
      <p class="drive-cta-blurb muted" data-reveal>
        A tiny 3D world with landmarks that each hold a piece of my resume.
      </p>
      <div class="drive-cta-actions" data-reveal>
        <button type="button" class="btn solid" data-drive-toggle data-magnetic>Start driving →</button>
        <span class="mono muted">or press <kbd>D</kbd> anywhere</span>
      </div>
    </div>
    <button type="button" class="drive-stage" data-drive-toggle data-cursor="drive" aria-label="Start drive mode">
      <span class="globe" aria-hidden="true">
        {[0, 30, 60, 90, 120, 150].map((d) => <span class="globe-m" style={`--r:${d}deg`}></span>)}
        {[-50, -25, 0, 25, 50].map((l) => <span class="globe-p" style={`--l:${l}`}></span>)}
        {pins.map(([lon, lat]) => <span class="globe-pin" style={`--lon:${lon}deg;--lat:${lat}deg`}></span>)}
      </span>
      <canvas class="drive-car" data-hero3d aria-hidden="true"></canvas>
    </button>
  </section>

  <!-- Order up -->
  <section class="wrap order-cta" data-reveal>
    <a href="/order" class="order-card" data-cursor="order">
      <span class="order-ticket mono" aria-hidden="true">
        <span>TICKET #0423</span><span>1 × Restaurant POS</span><span>2 × React</span><span>1 × Head TA</span><span class="order-rule"></span><span>TOTAL · one conversation</span>
      </span>
      <span class="order-text">
        <span class="eyebrow">Hungry for more?</span>
        <span class="display order-title">Order off my <em>menu</em> →</span>
        <span class="muted">A tiny version of the POS I built for the restaurant. Ring in projects and skills, and print a ticket you can send me.</span>
      </span>
    </a>
  </section>

  <!-- Beyond the code -->
  <section class="wrap beyond">
    <p class="eyebrow" data-reveal>Beyond the code</p>
    <h2 class="display section-title" data-flip3d>The <em>other</em> half</h2>
    <div class="beyond-grid">
      {beyond.map((b, i) => (
        <a href={b.href} class="beyond-card" data-cursor="open" data-reveal style={`--d:${i * 0.08}s`}>
          <div class="beyond-media" data-unmask>
            {b.photo && <Image src={b.photo.src} alt="" widths={[400, 700]} sizes="(max-width: 700px) 90vw, 25vw" data-zoom />}
          </div>
          <div class="beyond-text">
            <h3 class="display">{b.title}</h3>
            <p class="muted">{b.blurb}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: 70svh; display: flex; align-items: center; overflow: hidden; }
  .hero-card { position: absolute; right: max(var(--pad), calc((100vw - var(--max)) / 2 + var(--pad))); top: 52%; translate: 0 -50%; z-index: 1;
    width: min(36vw, 440px); margin: 0; background: var(--bg); border: 1.5px solid var(--fg); border-radius: var(--radius); box-shadow: 4px 4px 0 var(--fg); overflow: hidden; }
  .hc-bar { display: flex; align-items: center; gap: 0.8rem; padding: 0.65rem 0.9rem; border-bottom: 1.5px solid var(--fg); background: var(--bg-2); }
  .hc-dots { display: flex; gap: 0.35rem; }
  .hc-dots i { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--fg); }
  .hc-dots i:first-child { background: var(--accent); }
  .hc-file { flex: 1; font-size: 0.78rem; opacity: 0.7; }
  .hc-code { margin: 0; padding: 1.3rem 1.4rem 1rem; font-size: clamp(0.78rem, 1vw, 0.92rem); line-height: 1.75; white-space: pre; overflow: hidden; }
  .hc-code .k { color: var(--accent); font-weight: 600; }
  .hc-code .v { font-weight: 600; }
  .hc-code .s { color: color-mix(in oklab, #2f8f5b 85%, var(--fg)); }
  .hc-caret { display: inline-block; width: 0.55em; height: 1.1em; margin-left: 2px; vertical-align: -0.2em; background: var(--accent); animation: caret 1.1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .hc-foot { display: flex; justify-content: space-between; align-items: center; padding: 0.7rem 1.4rem 0.9rem; border-top: 1px dashed color-mix(in oklab, var(--fg) 30%, transparent); }
  .hc-status { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 500; }
  .hc-sign { font-size: 1.6rem; color: var(--accent); transform: rotate(-4deg); }
  @media (max-width: 1000px) { .hero-card { display: none; } }
  .hero-inner { position: relative; z-index: 2; padding-block: 7rem 1rem; }
  .hero-name {
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1;
    margin: 1rem 0 1.4rem;
    user-select: none; touch-action: none;
    width: fit-content;
  }
  .hero-name .row { display: block; white-space: nowrap; }
  .char.space { width: 0.25em; }
  .hero-name .italic { font-size: 1.15em; }
  .char {
    display: inline-block;
    transition: font-variation-settings 0.6s var(--ease), transform 0.6s var(--ease), color 0.4s;
    animation: char-in 1.4s var(--ease) backwards;
    animation-delay: calc(var(--i) * 0.05s + 0.1s);
  }
  .char.dot { color: var(--accent); }
  .start-here { position: absolute; left: -0.4rem; top: -3.4rem; display: flex; align-items: flex-start; gap: 0.1rem; color: var(--accent); font-size: 1.5rem; transform: rotate(-6deg); pointer-events: none; }
  .start-here svg { width: 34px; height: 30px; margin-top: 0.9rem; }
  .hero-actions { position: relative; }
  @keyframes char-in { from { transform: translateY(110%) rotate(8deg); opacity: 0; } }
  .hero-name:global(.charging) { animation: shake 0.12s linear infinite; }
  .hero-name:global(.charging) .char { color: var(--accent); }
  @keyframes shake { 0% { transform: translate(1px, 0); } 50% { transform: translate(-1px, 1px); } 100% { transform: translate(0, -1px); } }

  .hero-headline { font-size: clamp(1.15rem, 1.6vw, 1.45rem); max-width: 52ch; color: var(--fg-2); }
  .hero-actions { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin-top: 3.6rem; }
  .hero-socials { display: inline-flex; gap: 1.2rem; margin-left: 0.8rem; font-size: 0.85rem; }
  .hero-clock { margin-top: 2.5rem; display: flex; align-items: center; gap: 0.8rem; font-size: 0.8rem; flex-wrap: wrap; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #3ddc84; box-shadow: 0 0 0 0 #3ddc84; animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px transparent; } }

  .intro { padding-block: 1.5rem 1rem; }
  .intro-text { font-size: clamp(1.3rem, 2vw, 1.75rem); font-weight: 500; line-height: 1.3; max-width: 44ch; letter-spacing: -0.01em; }
  .currently { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1px; margin-top: 2rem; background: var(--fg); border: 1.5px solid var(--fg); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); gap: 1.5px; }
  .cur { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.4rem; background: var(--bg); }
  .cur .mono { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; padding-block: 2.5rem 1rem; }
  .stat { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.3rem 1.4rem 1.5rem; border: 1.5px solid var(--fg); border-top: 7px solid var(--c); border-radius: var(--radius); box-shadow: var(--shadow); background: var(--card); }
  .stat:nth-child(1) { --c: var(--yellow); }
  .stat:nth-child(2) { --c: var(--pink); }
  .stat:nth-child(3) { --c: var(--blue); }
  .stat:nth-child(4) { --c: var(--mint); }
  .stat-n { font-size: clamp(2.4rem, 4vw, 3.4rem); }
  .stat .muted { font-size: 0.9rem; max-width: 24ch; }

  .section-title { font-size: clamp(2rem, 3.6vw, 3rem); margin-top: 0.6rem; }

  .drive-cta { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: 3rem 4rem; }
  .drive-cta-blurb { font-size: 1.1rem; max-width: 42ch; margin-top: 1.5rem; }
  .drive-cta-actions { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-top: 2rem; }
  .drive-cta-actions .mono { font-size: 0.78rem; }
  kbd { font-family: var(--font-mono); font-size: 0.85em; padding: 0.1em 0.5em; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 6px; }
  .drive-stage { position: relative; aspect-ratio: 1; width: 100%; max-width: 560px; justify-self: center; display: grid; place-items: center; perspective: 1200px; }
  .drive-car { position: absolute; inset: -6% -10%; width: 120%; height: 112%; opacity: 0; transition: opacity 1.2s var(--ease), transform 0.8s var(--ease); }
  .drive-car:global(.ready) { opacity: 1; }
  .drive-stage:hover .drive-car { transform: translateY(-8px) scale(1.03); }
  .globe { position: absolute; width: 74%; aspect-ratio: 1; transform-style: preserve-3d; animation: globe-spin 28s linear infinite; top: 4%; }
  .globe-m, .globe-p { position: absolute; inset: 0; border-radius: 50%; border: 1px solid color-mix(in oklab, var(--fg) 22%, transparent); }
  .globe-m { transform: rotateY(var(--r)); }
  .globe-p { inset: auto; left: 50%; top: calc(50% - sin(var(--l) * 1deg) * 50%); width: calc(100% * cos(var(--l) * 1deg)); aspect-ratio: 1; transform: translate(-50%, -50%) rotateX(90deg); }
  .globe-pin { position: absolute; left: 50%; top: 50%; width: 10px; height: 10px; margin: -5px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); transform: rotateY(var(--lon)) rotateX(var(--lat)) translateZ(calc(min(560px, 40vw) * 0.37)); }
  @keyframes globe-spin { to { transform: rotateX(-14deg) rotateY(360deg); } }
  @media (prefers-reduced-motion: reduce) { .globe { animation: none; transform: rotateX(-14deg); } }
  @media (max-width: 860px) {
    .drive-cta { grid-template-columns: 1fr; }
    .globe-pin { transform: rotateY(var(--lon)) rotateX(var(--lat)) translateZ(calc(min(560px, 90vw) * 0.37)); }
  }

  .featured { padding-block: 3.5rem; }
  .toolbox { display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem 3rem; padding-block: 1.5rem 0; }
  .toolbox .mono { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .toolbox p { margin: 0.4rem 0 0; line-height: 1.6; }
  @media (max-width: 760px) { .toolbox { grid-template-columns: 1fr; } }
  .featured-head { margin-bottom: 3rem; }
  .featured-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1.2rem, 2vw, 2rem); }
  @media (max-width: 1000px) { .featured-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .featured-grid { grid-template-columns: 1fr; } }
  .featured-more { min-height: 220px; display: flex; flex-direction: column; justify-content: center; gap: 1rem; font-size: clamp(1.5rem, 2.2vw, 2rem); border: 1.5px dashed var(--fg); border-radius: var(--radius); padding: 2rem; transition: background 0.3s, transform 0.2s; }
  .featured-more:hover { background: var(--bg-2); }
  .featured-more .arrow { transition: transform 0.6s var(--ease); display: inline-block; }
  .featured-more:hover .arrow { transform: translateX(20px) rotate(-45deg); }

  .exp { padding-block: 2.5rem; }
  .exp-list { list-style: none; padding: 0; margin: 2.5rem 0; border-top: 1.5px solid var(--fg); }
  .exp-row { display: grid; grid-template-columns: 3rem minmax(0, 1.2fr) minmax(0, 1fr) 6rem; gap: 1.5rem; align-items: center; padding: 1.3rem 0; border-bottom: 1px dashed color-mix(in oklab, var(--fg) 30%, transparent); position: relative; transition: padding 0.3s var(--ease), color 0.3s; }
  .exp-row::before { content: ''; position: absolute; inset: 0; background: var(--bg-2); border-radius: 12px; inset: 0 -1rem; transform: scaleY(0); transform-origin: bottom; transition: transform 0.5s var(--ease); z-index: -1; }
  .exp-row:hover::before { transform: scaleY(1); }
  
  .exp-role { font-size: clamp(1.1rem, 1.6vw, 1.35rem); line-height: 1.25; }
  .exp-org { line-height: 1.4; }
  .exp-date { text-align: right; }
  .exp-row { isolation: isolate; }
  @media (max-width: 700px) {
    .exp-row { grid-template-columns: 2rem 1fr; }
    .exp-org, .exp-date { grid-column: 2; text-align: left; }
  }

  .order-cta { padding-block: 2rem 4rem; }
  .order-card { display: grid; grid-template-columns: auto 1fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding: clamp(1.5rem, 4vw, 3rem); border-radius: var(--radius); background: var(--bg-2); border: 1.5px solid var(--fg); box-shadow: var(--shadow); transition: background 0.5s var(--ease); }
  .order-card:hover { background: color-mix(in oklab, var(--yellow) 15%, var(--bg-2)); }
  .order-ticket { display: grid; gap: 0.2rem; width: 220px; padding: 1.2rem 1rem 1.6rem; background: #fbfaf6; color: #1c1a17; font-size: 0.72rem; box-shadow: var(--shadow); transform: rotate(-4deg); transition: transform 0.7s var(--ease); mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 12px 100%; }
  .order-card:hover .order-ticket { transform: rotate(2deg) translateY(-6px); }
  .order-rule { border-top: 1px dashed #b8b2a6; margin: 0.3rem 0; }
  .order-text { display: grid; gap: 0.8rem; }
  .order-title { font-size: clamp(1.7rem, 3vw, 2.5rem); line-height: 1.05; }
  @media (max-width: 700px) { .order-card { grid-template-columns: 1fr; } .order-ticket { justify-self: center; } }

  .beyond { padding-block: 3.5rem 2rem; }
  .beyond-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-top: 3rem; }
  .beyond-card { display: flex; flex-direction: column; gap: 1rem; }
  .beyond-card:nth-child(even) { margin-top: 4rem; }
  .beyond-media { aspect-ratio: 3 / 4; overflow: hidden; border-radius: var(--radius); background: var(--bg-2); border: 1.5px solid var(--fg); box-shadow: var(--shadow); transition: transform 0.2s; }
  .beyond-card:hover .beyond-media { transform: translateY(-3px); }
  .beyond-media img { width: 100%; height: 100%; object-fit: cover; }
  .beyond-card:hover .beyond-media img { filter: none; }
  .beyond-text h3 { font-size: 1.5rem; transition: transform 0.5s var(--ease); }
  .beyond-card:hover h3 { transform: translateX(0.5rem); color: var(--accent); }
  @media (max-width: 900px) { .beyond-grid { grid-template-columns: 1fr 1fr; } }
</style>
