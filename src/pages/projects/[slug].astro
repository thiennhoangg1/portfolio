---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { genArt } from '../../lib/genart';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const art = genArt(project.id, 1600, 900);
const nextArt = genArt(next.id, 1600, 900);
---

<Base title={d.title} description={d.tagline}>
  <article>
    <header class="wrap phead">
      <a href="/projects" class="back mono link-line" data-reveal>← All projects</a>
      <h1 class="display ptitle" data-split="load">{d.title}</h1>
      <p class="lede" data-reveal style="--d:.3s">{d.tagline}</p>
      <dl class="meta mono" data-reveal style="--d:.4s">
        <div><dt>Year</dt><dd>{d.year}</dd></div>
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Type</dt><dd>{d.kind}</dd></div>
        <div><dt>Stack</dt><dd>{d.stack.join(', ')}</dd></div>
      </dl>
      {(d.link || d.repo) && (
        <div class="links" data-reveal style="--d:.5s">
          {d.link && <a class="btn solid" href={d.link} target="_blank" rel="noopener" data-magnetic>Visit site ↗</a>}
          {d.repo && <a class="btn" href={d.repo} target="_blank" rel="noopener" data-magnetic>Code ↗</a>}
        </div>
      )}
    </header>

    <div class="wrap">
      <div class="hero-media" transition:name={`cover-${project.id}`}>
        {d.cover ? <Image src={d.cover} alt="" widths={[800, 1400, 2000]} sizes="100vw" data-parallax="0.08" /> : <img src={art.url} alt="" data-parallax="0.08" />}
      </div>
    </div>

    <div class="wrap body">
      <div class="prose" data-reveal><Content /></div>
      {d.credits && <p class="credits mono muted" data-reveal>{d.credits}</p>}
    </div>
  </article>

  <a href={`/projects/${next.id}`} class="next" data-cursor="next">
    <div class="next-bg"><img src={nextArt.url} alt="" /></div>
    <div class="wrap next-inner">
      <span class="eyebrow">Next project</span>
      <span class="display next-title">{next.data.title} →</span>
    </div>
  </a>
</Base>

<style>
  .phead { padding-top: clamp(8rem, 16vh, 11rem); padding-bottom: 3rem; }
  .back { font-size: 0.8rem; }
  .ptitle { font-size: clamp(3.2rem, 10vw, 9rem); margin: 1.5rem 0; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.5rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 0.8rem; }
  .meta dt { color: var(--fg-3); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.7rem; margin-bottom: 0.3rem; }
  .links { display: flex; gap: 0.6rem; margin-top: 2rem; }
  .hero-media { aspect-ratio: 16 / 8; overflow: hidden; border-radius: var(--radius); background: var(--bg-2); }
  .hero-media img { width: 100%; height: 116%; object-fit: cover; margin-top: -8%; }
  .body { display: grid; grid-template-columns: 1fr 3fr; gap: 3rem; padding-block: 5rem; }
  .body .prose { grid-column: 2; font-size: 1.1rem; }
  .credits { grid-column: 2; font-size: 0.85rem; }
  @media (max-width: 860px) { .body { grid-template-columns: 1fr; } .body .prose, .credits { grid-column: 1; } }

  .next { position: relative; display: block; overflow: hidden; margin-top: 4rem; padding-block: clamp(5rem, 12vw, 10rem); color: #fff; isolation: isolate; }
  .next-bg { position: absolute; inset: 0; z-index: -1; }
  .next-bg::after { content: ''; position: absolute; inset: 0; background: rgb(0 0 0 / 0.45); transition: background 0.6s; }
  .next-bg img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.1); transition: transform 1.4s var(--ease); }
  .next:hover .next-bg img { transform: scale(1); }
  .next:hover .next-bg::after { background: rgb(0 0 0 / 0.25); }
  .next .eyebrow { color: rgb(255 255 255 / 0.75); }
  .next-title { display: block; font-size: clamp(2.6rem, 8vw, 7rem); margin-top: 1rem; transition: transform 0.7s var(--ease); }
  .next:hover .next-title { transform: translateX(1.5rem); font-style: italic; }
</style>
