---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const tracks = await Promise.all(
  (await getCollection('music'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (t) => ({ ...t, Content: (await render(t)).Content })),
);
---

<Base title="Music" description="Music sketches and songs by Thien Hoang.">
  <section class="wrap">
    <h1 class="page-title display" data-split="load">Music</h1>
    <p class="lede" data-reveal>
      Sketches, loops, and songs I haven't finished on purpose. Press play and keep browsing: the music follows you
      around the site.
    </p>
    {tracks.some((t) => t.data.sample) && (
      <p class="mono muted note" data-reveal>
        <span class="sample-badge">sample</span> These are placeholder tracks generated live in your browser. Real songs coming soon.
      </p>
    )}
  </section>

  <section class="wrap tracks">
    {tracks.map((t, i) => (
      <article
        class="track"
        data-reveal
        style={`--d:${i * 0.08}s`}
        data-track={JSON.stringify({ id: t.id, title: t.data.title, audio: t.data.audio, seed: t.data.seed, key: t.data.key, bpm: t.data.bpm })}
      >
        <button type="button" class="play" data-play data-cursor="play" aria-label={`Play ${t.data.title}`}>
          <canvas data-mode="ring" aria-hidden="true"></canvas>
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
          <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"></path></svg>
        </button>
        <div class="info">
          <div class="row mono muted">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <span>{t.data.date}</span>
            <span>{t.data.key} · {t.data.bpm} bpm</span>
          </div>
          <h2 class="display">{t.data.title}</h2>
          <p class="mood mono">{t.data.mood}</p>
          <div class="prose muted"><t.Content /></div>
          {t.data.embed ? (
            <iframe src={t.data.embed} title={t.data.title} loading="lazy" allow="autoplay; encrypted-media"></iframe>
          ) : (
            <div class="bar" data-progress aria-hidden="true"><canvas data-mode="bars"></canvas></div>
          )}
        </div>
      </article>
    ))}
  </section>
</Base>

<style>
  .note { display: flex; align-items: center; gap: 0.7rem; font-size: 0.8rem; margin-top: 1.5rem; }
  .tracks { display: grid; gap: 1.2rem; padding-block: 4rem 2rem; }
  .track {
    display: grid; grid-template-columns: auto 1fr; gap: clamp(1.2rem, 4vw, 3rem); align-items: center;
    padding: clamp(1.2rem, 3vw, 2rem); border: 1px solid var(--line); border-radius: calc(var(--radius) + 6px);
    background: var(--card);
    transition: border-color 0.4s, transform 0.6s var(--ease);
  }
  .track:hover { border-color: var(--fg-3); }
  .track:global(.playing) { border-color: var(--accent); }
  .play { position: relative; width: clamp(110px, 16vw, 170px); aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; background: var(--bg-2); }
  .play canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .play svg { position: relative; width: 34%; height: 34%; color: var(--fg); transition: transform 0.4s var(--ease); }
  .play:hover svg { transform: scale(1.15); }
  .i-pause, .track:global(.playing) .i-play { display: none; }
  .track:global(.playing) .i-pause { display: block; }
  .track:global(.playing) .play { animation: spin-slow 12s linear infinite; }
  .track:global(.playing) .play svg { animation: spin-slow 12s linear infinite reverse; }
  @keyframes spin-slow { to { transform: rotate(360deg); } }
  .row { display: flex; gap: 1.2rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .info h2 { font-size: clamp(2rem, 4.5vw, 3.6rem); margin: 0.4rem 0 0.3rem; }
  .track:global(.playing) h2 { font-style: italic; color: var(--accent); }
  .mood { font-size: 0.8rem; color: var(--fg-2); margin-bottom: 0.6rem; }
  .bar { position: relative; height: 40px; margin-top: 1rem; }
  .bar canvas { width: 100%; height: 100%; }
  .bar::after { content: ''; position: absolute; left: 0; bottom: -6px; height: 2px; width: calc(var(--p, 0) * 100%); background: var(--accent); transition: width 0.2s linear; }
  .bar:global(.infinite)::after { width: 100%; transform-origin: left; animation: breathe 2.4s ease-in-out infinite; }
  @keyframes breathe { 50% { opacity: 0.3; } }
  iframe { width: 100%; height: 152px; border: 0; border-radius: 12px; margin-top: 1rem; }
  @media (max-width: 600px) { .track { grid-template-columns: 1fr; } }
</style>
