---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const jobs = await Promise.all(
  (await getCollection('experience'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (j) => ({ ...j, Content: (await render(j)).Content })),
);
---

<Base title="Work" description="Experience: research, engineering, teaching, startups, and restaurant management.">
  <section class="wrap">
    <h1 class="page-title display" data-split="load">Work <em>&amp;</em> experience</h1>
    <div class="head-row">
      <p class="lede" data-reveal>Research, startups, teaching, security, and a restaurant. Scroll the timeline.</p>
      <a href="/resume.pdf" class="btn solid" target="_blank" rel="noopener" data-magnetic data-reveal>Download resume ↓</a>
    </div>
  </section>

  <section class="wrap timeline" data-timeline>
    <div class="timeline-rail" aria-hidden="true"><div class="timeline-fill"></div></div>
    <ol>
      {jobs.map((j, i) => (
        <li class="timeline-item" data-reveal>
          <span class="t-dot" aria-hidden="true"></span>
          <div class="t-date mono">
            {j.data.start ? `${j.data.start} to ${j.data.end}` : j.data.end}
            {j.data.current && <span class="now">● now</span>}
          </div>
          <div class="t-card">
            <h2 class="display">{j.data.role}</h2>
            <p class="t-org">{j.data.org} <span class="muted">· {j.data.location}</span></p>
            <div class="prose t-body"><j.Content /></div>
            <div class="t-tags">{j.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; padding-bottom: 5rem; }
  .timeline { position: relative; padding-bottom: 4rem; }
  .timeline ol { list-style: none; padding: 0; }
  .timeline-rail { position: absolute; top: 0; bottom: 4rem; left: calc(var(--pad) + 220px); width: 1px; background: var(--line); }
  .timeline-fill { position: absolute; inset: 0; background: var(--accent); transform-origin: top; transform: scaleY(0); }
  .timeline-item { position: relative; display: grid; grid-template-columns: 220px 1fr; gap: 3rem; padding-bottom: 4.5rem; }
  .t-dot {
    position: absolute; left: 220px; top: 0.55rem; width: 13px; height: 13px; margin-left: -6px; border-radius: 50%;
    background: var(--bg); border: 1px solid var(--fg-3); transition: background 0.4s, border-color 0.4s, transform 0.5s var(--ease);
  }
  .timeline-item:global(.active) .t-dot { background: var(--accent); border-color: var(--accent); transform: scale(1.4); }
  .t-date { font-size: 0.78rem; color: var(--fg-2); padding-top: 0.4rem; display: flex; flex-direction: column; gap: 0.3rem; padding-right: 1.5rem; text-align: right; }
  .now { color: #3ddc84; }
  .t-card h2 { font-size: clamp(1.8rem, 3.4vw, 3rem); transition: color 0.4s; }
  .timeline-item:global(.active) h2 { color: var(--fg); }
  .timeline-item:not(:global(.active)) h2 { color: var(--fg-3); }
  .t-org { margin: 0.4rem 0 1rem; font-weight: 500; }
  .t-body { color: var(--fg-2); font-size: 1rem; }
  .t-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.2rem; }
  @media (max-width: 760px) {
    .timeline-rail { left: var(--pad); }
    .timeline-item { grid-template-columns: 1fr; gap: 0.6rem; padding-left: 2rem; }
    .t-dot { left: 0; }
    .t-date { text-align: left; padding: 0; flex-direction: row; gap: 0.8rem; }
  }
</style>
