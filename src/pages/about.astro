---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import { education, hobbies, ranks, site, skills, whispers } from '../data/site';
import chessShot from '../assets/hobbies/chess.png';
import valorantShot from '../assets/hobbies/valorant.png';
import { photos } from '../lib/photos';

const collage = photos.slice(0, 5);
const shots = { chess: chessShot, valorant: valorantShot } as const;
const proofs = Object.fromEntries(
  await Promise.all(Object.entries(shots).map(async ([k, img]) => [k, {
    thumb: (await getImage({ src: img, width: 640, format: 'webp' })).src,
    full: (await getImage({ src: img, width: 2000, format: 'webp' })).src,
  }])),
);
---

<Base title="About" description={`About ${site.name}: CS student at WashU, software engineer, restaurant manager, poet and songwriter.`}>
  <section class="wrap about-top">
    <div class="about-text">
      <h1 class="page-title display" data-split="load">About <em>me</em></h1>
      <div class="prose" data-reveal>
        <p class="about-lede">
          I'm a computer science student at WashU: B.S. in December 2025, M.S. finishing December 2026.
        </p>
        <p>
          I'm head TA for Intro to AI, I do graduate research, and I've shipped full-stack products, an iOS health app,
          and computer vision tools.
        </p>
        <p>
          I also help run Cafe Mochi, a local restaurant, and built the POS, time clock and payroll tools it uses every
          day. A busy dinner rush is a great test for software.
        </p>
        <p>
          Off the clock I climb, lift, play chess, write <span class="whisper" data-line={whispers[5]}>poetry</span>, and make music.
        </p>
      </div>
      <div class="about-ctas" data-reveal style="--d:.1s">
        <a href="/resume.pdf" class="btn solid" target="_blank" rel="noopener" data-magnetic>Resume ↓</a>
        <a href={`mailto:${site.email}`} class="btn" data-magnetic>Say hello</a>
      </div>
    </div>

    <div class="collage" aria-hidden="true">
      {collage.map((p, i) => (
        <figure class={`c c${i}`}>
          <div data-unmask style={`--d:${i * 0.1}s`}>
            <Image src={p.src} alt="" widths={[300, 600]} sizes="(max-width: 900px) 45vw, 20vw" />
          </div>
        </figure>
      ))}
    </div>
  </section>

  <section class="wrap cards">
    <div class="card" data-reveal>
      <p class="eyebrow">Education</p>
      <h2 class="display">{education.school}</h2>
      <ul class="plain">{education.degrees.map((d) => <li>{d}</li>)}</ul>
      <p class="c-label mono muted">Honors</p>
      <p class="c-text">{education.honors.join(' · ')}</p>
      <p class="c-label mono muted">Coursework</p>
      <p class="c-text">{education.coursework.join(' · ')}</p>
    </div>

    <div class="card" data-reveal style="--d:.08s">
      <p class="eyebrow">Skills</p>
      <p class="c-label mono muted">Languages</p>
      <p class="c-text">{skills.languages.join(' · ')}</p>
      <p class="c-label mono muted">Tools</p>
      <p class="c-text">{skills.tools.join(' · ')}</p>
    </div>

    <div class="card" data-reveal style="--d:.16s">
      <p class="eyebrow">Off the clock</p>
      <ul class="ranks">
        {ranks.map((r) => {
          const proof = r.proof ? proofs[r.proof] : null;
          return (
            <li>
              <span>{r.game}</span>
              <span class="rank-value">
                {r.rank}
                {proof && <a href={proof.full} target="_blank" rel="noopener" class="mono proof" title={r.detail}>proof ↗</a>}
              </span>
            </li>
          );
        })}
      </ul>
      <ul class="hobbies">{hobbies.map((h) => <li class="tag">{h}</li>)}</ul>
    </div>
  </section>
</Base>

<style>
  .about-top { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; padding-bottom: 3rem; }
  .about-text .page-title { padding-bottom: 1.5rem; }
  .about-lede { font-size: clamp(1.15rem, 1.6vw, 1.35rem); color: var(--fg); font-weight: 500; }
  .about-text .prose p { margin: 0 0 0.9rem; color: var(--fg-2); }
  .about-text .prose .about-lede { color: var(--fg); }
  .about-ctas { display: flex; gap: 0.8rem; margin-top: 1.8rem; flex-wrap: wrap; }
  .collage { position: relative; height: clamp(380px, 38vw, 520px); margin-top: clamp(7rem, 15vh, 9rem); }
  .c { position: absolute; margin: 0; }
  .c > div { overflow: hidden; border-radius: 14px; border: 1.5px solid var(--fg); box-shadow: var(--shadow); }
  .c img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 3 / 4; display: block; }
  .c0 { width: 44%; top: 0; left: 4%; z-index: 2; }
  .c1 { width: 36%; top: 6%; right: 2%; }
  .c2 { width: 32%; top: 50%; left: 0; z-index: 3; }
  .c3 { width: 38%; top: 52%; right: 8%; z-index: 1; }
  .c4 { width: 24%; top: 36%; left: 38%; z-index: 4; }
  .c4 img { aspect-ratio: 1; }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; padding-block: 2rem 4rem; }
  .card { padding: 1.5rem 1.6rem 1.7rem; border: 1.5px solid var(--fg); border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow); }
  .card h2 { font-size: 1.35rem; line-height: 1.2; margin: 0.7rem 0 0.5rem; }
  .plain { list-style: none; padding: 0; margin: 0; color: var(--fg-2); font-size: 0.95rem; }
  .plain li + li { margin-top: 0.2rem; }
  .c-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 1.1rem 0 0.3rem; }
  .card .eyebrow + .c-label { margin-top: 0.8rem; }
  .c-text { margin: 0; font-size: 0.92rem; line-height: 1.6; color: var(--fg-2); }
  .ranks { list-style: none; padding: 0; margin: 0.8rem 0 0; }
  .ranks li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.45rem 0; border-bottom: 1px dashed color-mix(in oklab, var(--fg) 25%, transparent); font-size: 0.95rem; }
  .rank-value { font-weight: 600; color: var(--accent); display: inline-flex; gap: 0.6rem; align-items: baseline; }
  .proof { font-size: 0.68rem; font-weight: 400; color: var(--fg-2); text-decoration: underline; text-underline-offset: 3px; }
  .proof:hover { color: var(--accent); }
  .hobbies { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.2rem; }
  @media (max-width: 1000px) { .cards { grid-template-columns: 1fr; } }
  @media (max-width: 900px) {
    .about-top { grid-template-columns: 1fr; }
    .collage { height: 100vw; margin-top: 0; }
  }
</style>
