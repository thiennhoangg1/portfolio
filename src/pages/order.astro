---
// "Order up": a mini version of the restaurant POS I built. Visitors ring in
// projects, skills, and experience, then print a ticket that doubles as a
// note to me. Logic lives in scripts/order.ts.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, skills } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

// Prices are for fun: bigger stacks cost more, skills are cheap sides.
const menu = [
  {
    key: 'mains', label: 'Mains', note: 'projects',
    items: projects.map((p) => ({ id: `p-${p.id}`, name: p.data.title, desc: p.data.tagline, price: 8 + p.data.stack.length * 1.5, href: `/projects/${p.id}` })),
  },
  {
    key: 'specials', label: 'Specials', note: 'experience',
    items: jobs.map((j) => ({ id: `e-${j.id}`, name: j.data.role, desc: j.data.org, price: 12.5, href: '/experience' })),
  },
  {
    key: 'sides', label: 'Sides', note: 'skills',
    items: [...skills.languages, ...skills.tools].map((s) => ({ id: `s-${s}`, name: s, desc: '', price: 2.5, href: '' })),
  },
];
const ticketNo = String(Math.floor(Math.random() * 9000) + 1000);
---

<Base title="Order up" description="Order off my menu: projects, experience, and skills, rung in on a mini version of the restaurant POS I built.">
  <section class="wrap order-head">
    <h1 class="page-title display" data-split="load">Order <em>up.</em></h1>
    <p class="lede" data-reveal>
      I manage a restaurant and built the point-of-sale system it runs on. Here's a tiny version of it. Ring in whatever
      looks good, send the ticket to the kitchen, and it'll print a receipt you can send me.
    </p>
  </section>

  <section class="wrap pos" data-pos data-email={site.email} data-ticket={ticketNo}>
    <div class="pos-screen">
      <div class="pos-bar mono">
        <span><span class="pos-dot"></span> Station 1 · Server: Thien</span>
        <span data-pos-clock>--:--</span>
      </div>
      <div class="pos-tabs" role="tablist">
        {menu.map((m, i) => (
          <button type="button" role="tab" class={`pos-tab ${i === 0 ? 'on' : ''}`} data-tab={m.key} aria-selected={i === 0 ? 'true' : 'false'}>
            {m.label} <span class="mono">{m.note}</span>
          </button>
        ))}
      </div>
      {menu.map((m, i) => (
        <div class="pos-grid" data-panel={m.key} hidden={i !== 0}>
          {m.items.map((it) => (
            <button type="button" class="pos-item" data-item={it.id} data-name={it.name} data-price={it.price.toFixed(2)} data-href={it.href}>
              <span class="pos-item-name">{it.name}</span>
              {it.desc && <span class="pos-item-desc">{it.desc}</span>}
              <span class="pos-item-price mono">${it.price.toFixed(2)}</span>
            </button>
          ))}
        </div>
      ))}
    </div>

    <aside class="pos-ticket">
      <div class="pos-ticket-head mono">
        <span>Ticket #{ticketNo}</span>
        <span>Table: you</span>
      </div>
      <ul class="pos-lines" data-pos-lines aria-live="polite">
        <li class="pos-empty muted">Tap something on the menu to ring it in.</li>
      </ul>
      <dl class="pos-totals mono">
        <div><dt>Subtotal</dt><dd data-pos-sub>$0.00</dd></div>
        <div><dt>Hype tax (8.9%)</dt><dd data-pos-tax>$0.00</dd></div>
        <div class="pos-total"><dt>Total</dt><dd data-pos-total>$0.00</dd></div>
      </dl>
      <div class="pos-actions">
        <button type="button" class="pos-clear mono" data-pos-clear>Void</button>
        <button type="button" class="pos-send" data-pos-send disabled>Send to kitchen →</button>
      </div>
    </aside>
  </section>

  <section class="wrap printer-wrap" data-printer hidden>
    <div class="printer">
      <div class="printer-slot" aria-hidden="true"></div>
      <div class="receipt-clip">
        <div class="receipt mono" data-receipt></div>
      </div>
    </div>
    <form class="receipt-form" data-receipt-form>
      <p class="eyebrow">Send it to me</p>
      <label><span class="mono">Your name</span><input name="name" autocomplete="name" placeholder="Jordan from Acme" /></label>
      <label><span class="mono">Note for the kitchen</span><textarea name="note" rows="3" placeholder="Loved the POS. Want to chat about a role?"></textarea></label>
      <div class="receipt-btns">
        <button type="submit" class="btn solid">Email the ticket →</button>
        <button type="button" class="btn" data-receipt-copy>Copy</button>
        <button type="button" class="btn" data-receipt-print>Print</button>
      </div>
      <p class="mono muted small">Opens your email app with the ticket filled in, addressed to {site.email}.</p>
    </form>
  </section>
</Base>

<style>
  .order-head { padding-bottom: 2rem; }
  .order-head .lede { max-width: 56ch; }
  .pos { display: grid; grid-template-columns: 1fr 360px; gap: 1.2rem; padding-bottom: 4rem; align-items: start; }
  .pos-screen, .pos-ticket { border-radius: var(--radius); border: 1px solid var(--line); background: var(--card); overflow: hidden; }
  .pos-screen { background: #17171b; color: #ece7de; border-color: #26262b; }
  .pos-bar { display: flex; justify-content: space-between; padding: 0.8rem 1.1rem; font-size: 0.72rem; color: #8d8a84; border-bottom: 1px solid #26262b; }
  .pos-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #3ddc84; margin-right: 0.35rem; }
  .pos-tabs { display: flex; gap: 0.5rem; padding: 0.9rem 1.1rem 0; }
  .pos-tab { padding: 0.75rem 1.1rem; border-radius: 12px; background: #24242a; font-weight: 600; font-size: 0.95rem; display: flex; flex-direction: column; align-items: start; gap: 0.1rem; transition: background 0.25s; }
  .pos-tab .mono { font-size: 0.62rem; font-weight: 400; color: #8d8a84; text-transform: uppercase; letter-spacing: 0.1em; }
  .pos-tab.on { background: var(--accent); color: var(--accent-ink); }
  .pos-tab.on .mono { color: inherit; opacity: 0.7; }
  .pos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 0.6rem; padding: 1.1rem; }
  .pos-grid[hidden] { display: none; }
  .pos-item {
    min-height: 104px; padding: 0.85rem; border-radius: 14px; background: #24242a; border: 1px solid #2f2f36;
    display: flex; flex-direction: column; align-items: start; gap: 0.25rem; text-align: left;
    transition: transform 0.15s, background 0.2s, border-color 0.2s;
  }
  .pos-item:hover { border-color: var(--accent); }
  .pos-item:active, .pos-item.bump { transform: scale(0.96); background: #2e2e35; }
  .pos-item-name { font-weight: 600; line-height: 1.2; }
  .pos-item-desc { font-size: 0.75rem; color: #a59f95; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pos-item-price { margin-top: auto; font-size: 0.75rem; color: var(--accent); }

  .pos-ticket { position: sticky; top: 6rem; display: flex; flex-direction: column; }
  .pos-ticket-head { display: flex; justify-content: space-between; padding: 0.9rem 1.1rem; font-size: 0.72rem; border-bottom: 1px dashed var(--line); }
  .pos-lines { list-style: none; padding: 0.6rem 1.1rem; margin: 0; min-height: 180px; max-height: 340px; overflow-y: auto; }
  .pos-lines :global(li) { display: grid; grid-template-columns: auto 1fr auto; gap: 0.6rem; align-items: center; padding: 0.45rem 0; border-bottom: 1px solid var(--line); animation: line-in 0.35s var(--ease); }
  .pos-lines :global(.pos-empty) { display: block; border: 0; font-size: 0.9rem; padding-top: 1rem; animation: none; }
  @keyframes line-in { from { opacity: 0; transform: translateX(12px); } }
  .pos-lines :global(.pos-qty) { display: inline-flex; align-items: center; gap: 0.3rem; }
  .pos-lines :global(.pos-qty button) { width: 24px; height: 24px; border-radius: 50%; border: 1px solid var(--line); line-height: 1; }
  .pos-lines :global(.pos-qty button:hover) { border-color: var(--fg); }
  .pos-lines :global(.pos-line-name) { font-size: 0.9rem; line-height: 1.25; }
  .pos-lines :global(.pos-line-price) { font-family: var(--font-mono); font-size: 0.8rem; }
  .pos-totals { padding: 0.8rem 1.1rem; margin: 0; font-size: 0.8rem; border-top: 1px dashed var(--line); display: grid; gap: 0.25rem; }
  .pos-totals div { display: flex; justify-content: space-between; }
  .pos-totals dd { margin: 0; }
  .pos-total { font-size: 1rem; font-weight: 700; padding-top: 0.3rem; }
  .pos-actions { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem; padding: 0 1.1rem 1.1rem; }
  .pos-clear { padding: 0.9rem 1.1rem; border-radius: 12px; border: 1px solid var(--line); font-size: 0.8rem; }
  .pos-send { padding: 0.9rem; border-radius: 12px; background: #3ddc84; color: #0b1f12; font-weight: 700; transition: opacity 0.2s, transform 0.15s; }
  .pos-send:disabled { opacity: 0.35; cursor: not-allowed; }
  .pos-send:not(:disabled):active { transform: scale(0.97); }

  .printer-wrap { scroll-margin-top: 6rem; display: grid; grid-template-columns: 380px 1fr; gap: clamp(2rem, 5vw, 5rem); padding-bottom: 6rem; align-items: start; }
  .printer-wrap[hidden] { display: none; }
  .printer { position: relative; padding-top: 18px; }
  .printer-slot { position: absolute; top: 0; left: -14px; right: -14px; height: 26px; border-radius: 10px; background: #1b1b20; box-shadow: inset 0 -8px 0 #0e0e11, 0 10px 30px -10px rgb(0 0 0 / 0.5); z-index: 2; }
  .receipt-clip { overflow: hidden; padding-bottom: 20px; }
  .receipt {
    --printed: 0;
    background: #fbfaf6; color: #1c1a17; padding: 1.6rem 1.4rem 2rem; font-size: 0.78rem; line-height: 1.6;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.35);
    transform: translateY(calc((var(--printed) - 1) * 100%));
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 14px 100%;
  }
  .receipt :global(.r-center) { text-align: center; }
  .receipt :global(.r-big) { font-size: 1.1rem; font-weight: 700; letter-spacing: 0.08em; }
  .receipt :global(.r-row) { display: flex; justify-content: space-between; gap: 1rem; }
  .receipt :global(.r-rule) { border-top: 1px dashed #b8b2a6; margin: 0.6rem 0; }
  .receipt :global(.r-bar) { height: 46px; margin-top: 1rem; background: repeating-linear-gradient(90deg, #1c1a17 0 2px, transparent 2px 4px, #1c1a17 4px 5px, transparent 5px 8px, #1c1a17 8px 11px, transparent 11px 12px); }
  .receipt-form { display: grid; gap: 1rem; max-width: 520px; }
  .receipt-form label { display: grid; gap: 0.4rem; }
  .receipt-form label .mono { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-2); }
  .receipt-form input, .receipt-form textarea { font: inherit; padding: 0.8rem 1rem; border-radius: 12px; border: 1px solid var(--line); background: var(--card); color: var(--fg); }
  .receipt-form input:focus, .receipt-form textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .receipt-btns { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .small { font-size: 0.75rem; }

  @media (max-width: 900px) {
    .pos, .printer-wrap { grid-template-columns: 1fr; }
    .pos-ticket { position: static; }
    .pos-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
  }
  @media print {
    .order-head, .pos, .receipt-form, .printer-slot { display: none !important; }
    .printer-wrap { display: block; }
    .receipt { transform: none; box-shadow: none; mask: none; }
  }
</style>
