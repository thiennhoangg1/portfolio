---
import Base from '../layouts/Base.astro';
---

<Base title="Lost">
  <section class="wrap lost">
    <h1 class="display big" data-split="load">4<em>0</em>4</h1>
    <p class="lede" data-lost-msg>This page wandered off. It's somewhere in the box below. Catch it.</p>
    <div class="arena" data-lost-arena>
      <button type="button" class="runaway" data-lost data-cursor="catch" aria-label="The missing page">
        <span aria-hidden="true">📄</span>
      </button>
    </div>
    <div class="actions">
      <a href="/" class="btn solid" data-magnetic>Take me home</a>
      <button type="button" class="btn" data-term-open data-magnetic>Open terminal</button>
    </div>
  </section>
</Base>

<style>
  .lost { padding-top: clamp(7rem, 14vh, 10rem); }
  .big { font-size: clamp(7rem, 30vw, 26rem); line-height: 0.8; }
  .big em { color: var(--accent); }
  .arena { position: relative; height: 320px; margin: 3rem 0 2rem; border: 1px dashed var(--line); border-radius: var(--radius); overflow: hidden; background: repeating-linear-gradient(45deg, transparent 0 14px, color-mix(in oklab, var(--fg) 3%, transparent) 14px 15px); }
  .runaway { position: absolute; top: 0; left: 0; width: 60px; height: 60px; border-radius: 16px; display: grid; place-items: center; font-size: 1.8rem; background: var(--card); box-shadow: var(--shadow); }
  .runaway:global(.caught) { background: var(--accent); animation: bounce 0.6s var(--ease) 3; }
  @keyframes bounce { 50% { scale: 1.3; } }
  .actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
</style>
