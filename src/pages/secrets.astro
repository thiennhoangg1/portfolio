---
import Base from '../layouts/Base.astro';
import { SECRETS } from '../scripts/secrets';
---

<Base title="The vault" description="A list of hidden things.">
  <section class="wrap">
    <h1 class="page-title display" data-split="load">The <em>vault</em></h1>
    <p class="lede" data-reveal>You found the secret page, which is itself a secret. Here's everything hidden on this site.</p>
    <div class="score" data-reveal>
      <span class="display" data-secrets-count>0/{SECRETS.length}</span>
      <div class="meter" data-secrets-bar><span></span></div>
    </div>
  </section>
  <section class="wrap">
    <ol class="secrets" data-secrets></ol>
    <p class="mono muted reset">Want to start over? Type <kbd>reset-secrets</kbd> in the terminal.</p>
  </section>
</Base>

<style>
  .score { display: flex; align-items: center; gap: 2rem; margin-top: 2.5rem; }
  .score .display { font-size: clamp(3rem, 8vw, 6rem); }
  .meter { flex: 1; height: 6px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .meter span { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--accent); transition: width 1s var(--ease); }
  .secrets { list-style: none; padding: 3rem 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .secrets :global(li) { display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 1rem; padding: 1.3rem; border: 1px dashed var(--line); border-radius: 14px; color: var(--fg-3); }
  .secrets :global(li.found) { border-style: solid; border-color: var(--accent); color: var(--fg); }
  .secrets :global(.s-icon) { grid-row: span 2; font-size: 1.4rem; color: var(--accent); }
  .secrets :global(.s-title) { font-family: var(--font-display); font-size: 1.4rem; }
  .secrets :global(.s-hint) { font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-2); }
  .reset { font-size: 0.8rem; }
</style>
