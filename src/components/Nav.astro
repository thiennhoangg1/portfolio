---
import { nav, site } from '../data/site';
---

<header class="nav" transition:persist="nav">
  <a href="/" class="logo" aria-label={`${site.name}, home`} data-magnetic="0.4" data-cursor="home">
    <span class="logo-mark" aria-hidden="true">✦</span>
    <span class="logo-text" data-scramble>Thien Hoang</span>
  </a>

  <nav class="links" aria-label="Primary" data-nav>
    {nav.slice(1).map((l) => (
      <a href={l.href}><span data-scramble>{l.label}</span></a>
    ))}
  </nav>

  <div class="tools">
    <button type="button" class="tool secrets-pill mono" data-term-open data-cursor="⌘K" aria-label="Open terminal and secrets">
      <span aria-hidden="true">✦</span> <span data-secret-count>0/17</span>
    </button>
    <button type="button" class="tool" data-sound-toggle aria-label="Toggle sound effects" data-cursor="sound">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="i-sound">
        <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"></path>
        <path class="wave" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        <path class="mute" d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
    <button type="button" class="tool theme-toggle" data-theme-toggle aria-label="Toggle dark mode" data-cursor="flip">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <mask id="moon-mask"><rect width="24" height="24" fill="#fff"></rect><circle class="moon-cut" cx="24" cy="4" r="7" fill="#000"></circle></mask>
        <circle class="sun-core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#moon-mask)"></circle>
        <g class="rays" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M12 1.5v2M12 20.5v2M1.5 12h2M20.5 12h2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M4.6 19.4L6 18M18 6l1.4-1.4"></path>
        </g>
      </svg>
    </button>
    <button type="button" class="tool menu-btn" data-menu-toggle aria-label="Menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" aria-label="Menu">
  <nav data-nav>
    {nav.map((l, i) => (
      <a href={l.href} style={`--i:${i}`}>
        <span class="mono menu-num">0{i + 1}</span>
        <span class="display">{l.label}</span>
      </a>
    ))}
  </nav>
  <p class="mono muted">tip: press ⌘K or / for the terminal</p>
</div>
