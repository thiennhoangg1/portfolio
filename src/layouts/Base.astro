---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import Chrome from '../components/Chrome.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/chrome.css';
import '../styles/drive.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const music = (await getCollection('music')).sort((a, b) => a.data.order - b.data.order);
const poems = (await getCollection('poems')).sort((a, b) => a.data.order - b.data.order);
const bullets = (md = '') => md.split('\n').filter((l) => l.startsWith('- ')).map((l) => l.slice(2).trim());
const drive = {
  projects: projects.map((p) => ({ slug: p.id, title: p.data.title, tagline: p.data.tagline, kind: p.data.kind, year: p.data.year, role: p.data.role, stack: p.data.stack })),
  experience: experience.map((e) => ({ id: e.id, role: e.data.role, org: e.data.org, location: e.data.location, start: e.data.start, end: e.data.end, tags: e.data.tags, bullets: bullets(e.body) })),
  music: music.map((m) => ({ id: m.id, title: m.data.title, mood: m.data.mood || (m.data.artist === 'Thien Hoang' ? 'original' : `by ${m.data.artist}`), audio: m.data.audio, seed: m.data.seed, key: m.data.key, bpm: m.data.bpm })),
  poems: poems.map((p) => ({ id: p.id, title: p.data.title })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2eee6" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var t = localStorage.getItem('th-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        d.dataset.theme = t;
        var a = localStorage.getItem('th-accent');
        if (a) d.style.setProperty('--accent', a);
        if (/[?&]recruiter\b/.test(location.search)) localStorage.setItem('th-recruiter', 'on');
        if (localStorage.getItem('th-recruiter') === 'on') d.classList.add('recruiter');
        d.classList.add('js');
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Chrome projects={projects.map((p) => ({ slug: p.id, title: p.data.title, tagline: p.data.tagline }))} drive={drive} />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
